#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
const args = process.argv.slice(2);
const url = args.at(-1);
const id = new URL(url).searchParams.get('v');
if (id === 'xxxxxxxxxxx') {
  process.stderr.write('ERROR: Private video');
  process.exit(1);
}
if (args.includes('--dump-single-json')) {
  const delay = Number(process.env.AUTO_DIGGER_TEST_PROBE_DELAY || '0');
  if (delay > 0) await new Promise((done) => setTimeout(done, delay));
  process.stdout.write(
    JSON.stringify({
      id,
      title: id === 'lmnopqrstuv' ? 'Unknown upload' : 'Low Tide - Quiet Orbit',
      is_live: false,
      url: 'https://fixture.googlevideo.com/audio',
    }),
  );
} else {
  if (process.env.AUTO_DIGGER_TEST_DOWNLOAD_LOG)
    fs.appendFileSync(process.env.AUTO_DIGGER_TEST_DOWNLOAD_LOG, 'download\n');
  const target = args[args.indexOf('--output') + 1].replace('%(ext)s', 'mp3');
  if (args.includes('--progress'))
    process.stdout.write(
      'AD_PROGRESS:{"downloaded_bytes":25,"total_bytes":100,"speed":50,"eta":1}\n',
    );
  const finish = () => {
    fs.copyFileSync(path.join(import.meta.dirname, 'tone.mp3'), target);
    if (args.includes('--progress'))
      process.stdout.write(
        'AD_PROGRESS:{"downloaded_bytes":100,"total_bytes":100}\nAD_POSTPROCESS:"started"\n',
      );
  };
  if (id === 'slowvideo01') setTimeout(finish, 1500);
  else finish();
}
