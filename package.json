{
  "name": "auto-digger",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "A quiet desk for discovering records.",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.ts --host 127.0.0.1",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.cjs --max-warnings 0 --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "site:dev": "vite --config site.vite.config.ts",
    "site:build": "vite build --config site.vite.config.ts",
    "site:preview": "vite preview --config site.vite.config.ts",
    "site:verify": "vitest run --project site",
    "site:screenshots": "yarn build && node --experimental-strip-types scripts/capture-project-site.ts",
    "verify": "yarn icons:check && yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "icons:generate": "node --experimental-strip-types scripts/generate-icons.ts",
    "icons:check": "node --experimental-strip-types scripts/generate-icons.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "discogs-dataset-genres-styles": "2.0.0",
    "lucide-react": "^1.61.0",
    "node-id3": "0.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "5.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.3",
    "png2icons": "2.0.1",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
